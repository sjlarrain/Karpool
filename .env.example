# ============================================================================
# Carpool App — environment template
# Copy to .env.local and fill from 01_PLATFORM_SETUP.md §7.
# .env.local is gitignored and unreadable by the agent. Never commit values.
# Every variable here is validated at boot by src/env.ts.
# ============================================================================

# ─── App ─────────────────────────────────────────────────────────────────
# Local: http://localhost:3000 · Deployed: your Vercel URL or custom domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | preview | production
APP_ENV=development

# ─── Supabase (Project Settings → API) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
# SECRET — bypasses RLS. Server only. Never in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# ─── Supabase database (Project Settings → Database) ─────────────────────
# SECRET — pooled connection, port 6543, transaction mode (runtime)
DATABASE_URL=REPLACE_ME
# SECRET — direct connection, port 5432 (migrations only)
DIRECT_URL=REPLACE_ME

# ─── Web Push / VAPID (npx web-push generate-vapid-keys) ─────────────────
VAPID_SUBJECT=mailto:REPLACE_ME@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_ME
# SECRET — rotating this invalidates every existing push subscription
VAPID_PRIVATE_KEY=REPLACE_ME

# ─── Google Maps (Google Cloud → Credentials) ────────────────────────────
# SECRET — server key, restricted to Directions + Places, with a quota cap
GOOGLE_MAPS_SERVER_KEY=REPLACE_ME
# Only if decision D-03 lands on a browser-rendered map.
# Must be HTTP-referrer restricted to your domains. Leave blank otherwise.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ─── Vercel cron (openssl rand -base64 32) ───────────────────────────────
# SECRET — /api/cron/tick rejects any request without this bearer token
CRON_SECRET=REPLACE_ME

# ─── Admin bootstrap ─────────────────────────────────────────────────────
# The email promoted to the first platform_admin by scripts/bootstrap-admin.ts
ADMIN_BOOTSTRAP_EMAIL=REPLACE_ME@example.com
